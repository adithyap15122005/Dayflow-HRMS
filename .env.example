# ---------------------------------------------------------------------------
# Dayflow HRMS — environment template
# Copy to `.env` (`npm run setup` does this for you) before running the app.
# ---------------------------------------------------------------------------

# SQLite database file. Relative paths are resolved from ./prisma
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. MUST be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# Session lifetime in hours.
SESSION_TTL_HOURS="12"

# Set to "true" to print the email-verification link to the server console
# instead of sending a real email (there is no SMTP dependency in this build).
DEV_SHOW_VERIFICATION_LINK="true"
